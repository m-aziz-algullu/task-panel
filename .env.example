# PostgreSQL connection string. REQUIRED in production (the server won't start
# without it). Locally you can leave it empty to use an embedded PGlite database.
DATABASE_URL=
# Max Postgres connections (default 5).
# DATABASE_POOL_SIZE=5

# Optional: your own setup code for creating the admin account. If unset, a
# one-time code is generated and printed in the server logs on first start.
# SETUP_TOKEN=

# Time zone that decides when a day ends (finished tasks leave the board at midnight).
APP_TIMEZONE=Europe/Istanbul

# Development only: where the embedded PGlite database stores data.
# PGLITE_DIR=./.data/pglite   (memory:// keeps it in memory; the DB tests use that)

# Web Push notifications (agent finished / needs you). Nothing to set: a key pair
# is generated on first use and kept in the database. To manage it yourself, set
# both (npx web-push generate-vapid-keys). VAPID_SUBJECT defaults to mailto: the
# admin account's email; Apple's push service wants a real contact.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Bundled OpenClaw agent (default Docker image). Nothing to set: the container
# generates its token on first start and keeps it in the /data volume.
# TASKPANEL_AGENT=off            # run the agent image without starting OpenClaw
# TASKPANEL_BROWSER_SANDBOX=on  # keep Chromium's sandbox (the container needs SYS_ADMIN or a seccomp profile)
# OPENCLAW_GATEWAY_TOKEN=        # pin the token yourself instead
# Only model provider keys (and OpenClaw's own settings) reach the agent, e.g.:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
