# PostgreSQL connection string. REQUIRED in production (the server won't start
# without it). Locally you can leave it empty to use an embedded PGlite database.
DATABASE_URL=
# Max Postgres connections (default 5).
# DATABASE_POOL_SIZE=5

# Optional: your own setup code for creating the admin account. If unset, a
# one-time code is generated and printed in the server logs on first start.
# SETUP_TOKEN=

# Time zone that decides when a day ends (finished tasks leave the board at midnight).
APP_TIMEZONE=Europe/Istanbul

# Development only: where the embedded PGlite database stores data.
# PGLITE_DIR=./.data/pglite
